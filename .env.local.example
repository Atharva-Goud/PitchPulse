# Football API (default: https://worldcup26.ir/get/soccer — public, no key needed)
# For local dev with proxy: NEXT_PUBLIC_FOOTBALL_API_URL=http://localhost:3050
NEXT_PUBLIC_FOOTBALL_API_URL=https://worldcup26.ir/get/soccer

# NewsAPI (free tier at https://newsapi.org/) — optional, for news sync only
NEWS_API_KEY=your_newsapi_key_here
